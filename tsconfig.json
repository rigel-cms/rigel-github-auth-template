{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["node"],
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true, "erasableSyntaxOnly": true
  },
  "include": ["src/**/*.ts", "cloudflare/**/*.ts", "netlify/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "_temp", ".netlify", ".vercel", ".wrangler"]
}
